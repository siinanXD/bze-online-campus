# --- Supabase (öffentlich, im Client erlaubt) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Nur Edge Functions / Server. NIEMALS im Client. ---
SUPABASE_SERVICE_ROLE_KEY=
# EU-LLM-Anbieter mit AVV und ohne Trainingsnutzung
LLM_API_KEY=
LLM_MODELL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# LLM_MOCK=1  # lokal: Raster-Heuristik ohne LLM-Aufruf (AP-09)

# Admin-Content-Generator:
# true = deterministischer Mock-Provider ohne externen Aufruf.
# false = echter serverseitiger LLM-Provider, nur wenn LLM_API_KEY gesetzt ist.
AI_MOCK_MODE=true
# generated = kein Retrieval, knowledge_base = nur belegter Kontext, hybrid = Kontext + erlaubte Ergaenzung
CONTENT_SOURCE_MODE=generated
RAG_ENABLED=false
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.72
RAG_MOCK_RETRIEVAL=true

# --- App ---
NEXT_PUBLIC_DEFAULT_LOCALE=de

# --- Web Push (AP-17) ---
# VAPID-Schlüsselpaar erzeugen: npx web-push generate-vapid-keys
# Der öffentliche Schlüssel darf in den Client, der private niemals.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktangabe für den Push-Dienst (mailto: oder https:).
VAPID_SUBJECT=mailto:kontakt@bze-euskirchen.de
