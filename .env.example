# --- Supabase (öffentlich, im Client erlaubt) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Nur Edge Functions / Server. NIEMALS im Client. ---
SUPABASE_SERVICE_ROLE_KEY=
# EU-LLM-Anbieter mit AVV und ohne Trainingsnutzung
LLM_API_KEY=
LLM_MODELL=
LLM_BASE_URL=
# LLM_MOCK=1  # lokal: Raster-Heuristik ohne LLM-Aufruf (AP-09)

# --- App ---
NEXT_PUBLIC_DEFAULT_LOCALE=de

# --- Web Push (AP-17) ---
# VAPID-Schlüsselpaar erzeugen: npx web-push generate-vapid-keys
# Der öffentliche Schlüssel darf in den Client, der private niemals.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktangabe für den Push-Dienst (mailto: oder https:).
VAPID_SUBJECT=mailto:kontakt@bze-euskirchen.de
