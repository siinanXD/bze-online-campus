{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bze/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@bze/config/*": [
        "./packages/config/*"
      ],
      "@bze/db": [
        "./packages/db/index.ts"
      ],
      "@bze/db/server": [
        "./packages/db/server.ts"
      ],
      "@bze/db/browser": [
        "./packages/db/browser.ts"
      ],
      "@bze/core/mastery": [
        "./packages/core/mastery/index.ts"
      ],
      "@bze/core/bewertung": [
        "./packages/core/bewertung/index.ts"
      ],
      "@bze/core/fortschritt": [
        "./packages/core/fortschritt/index.ts"
      ],
      "@bze/core/nachweis": [
        "./packages/core/nachweis/index.ts"
      ],
      "@bze/core/engagement": [
        "./packages/core/engagement/index.ts"
      ],
      "@bze/core/benachrichtigung": [
        "./packages/core/benachrichtigung/index.ts"
      ],
      "@bze/core/werte": [
        "./packages/core/werte/index.ts"
      ],
      "@bze/core/content": [
        "./packages/core/content/index.ts"
      ],
      "@bze/core/fachkunde": [
        "./packages/core/fachkunde/index.ts"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    "supabase/functions",
    "**/*.mdx"
  ]
}
