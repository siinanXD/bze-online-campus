{
  "name": "bze-online-campus",
  "private": true,
  "version": "0.1.0",
  "description": "BZE Online Campus — Lern- und Prüfungsplattform (PWA) für Bildungsträger.",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/e2e/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/unit/**/*.test.ts\"",
    "lint:py": "ruff check scripts && ruff format --check scripts",
    "format:py": "ruff format scripts",
    "db:reset": "supabase db reset",
    "seed:generate": "python3 scripts/generate_seed.py",
    "design:shots": "node scripts/design-screenshots.mjs ./shots",
    "design:galerie": "node scripts/design-galerie.mjs ./shots ./galerie.html",
    "design:kontrast": "node scripts/kontrast-pruefung.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "next": "15.5.22",
    "next-intl": "^3.20.0",
    "next-mdx-remote": "^5.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.62.0",
    "postcss": "^8.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
